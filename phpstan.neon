includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Provided by ariaieboy/filament-jalali as runtime macros; not visible to static analysis.
        - '#^Call to an undefined method Filament\\Forms\\Components\\DatePicker::jalali\(\)\.$#'
        - '#^Call to an undefined method Filament\\Tables\\Columns\\TextColumn::jalaliDate(Time)?\(\)\.$#'
