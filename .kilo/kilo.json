{
  "$schema": "https://app.kilo.ai/config.json",
  "indexing": {
    "enabled": true,
    "provider": "openrouter"
  },
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "command": [
        "php",
        "artisan",
        "boost:mcp"
      ]
    },
    "sqlite": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "/Users/maht/Projects/kialent/database/database.sqlite"
      ]
    }
  },
  "plugin": [
    "file:///Users/maht/Projects/kialent/.kilo/plugins/graphify.js"
  ]
}